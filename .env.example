# Vercel: set these variables in Project → Settings → Environment Variables (not in git);
# this file is a local template for .env.local only. DEEPSEEK_* are server-only secrets
# consumed by the api/*.ts functions — never expose them to the client / no VITE_ prefix.

# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls.
# Get a key at https://platform.deepseek.com and set it in .env.local.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: Optional model override (default: deepseek-chat).
# DEEPSEEK_MODEL="deepseek-chat"

# DEEPSEEK_BASE_URL: Optional API base URL override (default: https://api.deepseek.com).
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# DEEPSEEK_MAX_TOKENS: Optional completion cap for JSON responses (default: 8192).
# DEEPSEEK_MAX_TOKENS="8192"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
