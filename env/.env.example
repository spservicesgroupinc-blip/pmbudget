# All env variables & API keys for this project live in the env/ folder:
#   env/.env.local — your real local secrets (git-ignored; copy this template there)
#   env/README.md  — full inventory of every variable, where it is used, and how it loads
# Vercel: set these variables in Project → Settings → Environment Variables (not in git).
# DEEPSEEK_* are server-only secrets consumed by the api/*.ts functions — never expose
# them to the client / no VITE_ prefix.

# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls.
# Get a key at https://platform.deepseek.com and set it in .env.local.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: Optional model override (default: deepseek-chat).
# DEEPSEEK_MODEL="deepseek-chat"

# DEEPSEEK_BASE_URL: Optional API base URL override (default: https://api.deepseek.com).
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# DEEPSEEK_MAX_TOKENS: Optional completion cap for JSON responses (default: 8192).
# DEEPSEEK_MAX_TOKENS="8192"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# APP_URL="https://your-app.example"

# VITE_GAPPS_WEB_APP_URL: Google Apps Script backend URL override.
# When unset, webAppUrl in env/gapps-config.json is used. On Vercel this can
# be set as a project env var and is baked into the client bundle at build time.
# Sign-up and login use individual accounts; no shared app/setup key is needed.
# VITE_GAPPS_WEB_APP_URL="https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec"
